# ── Telegram: бот (интерфейс клиента) ───────────────────────────────────────
# Токен у @BotFather. Отдельный аккаунт от юзербота — их нельзя совмещать.
BOT_TOKEN=

# ── Telegram: юзербот (чтение сообществ) ────────────────────────────────────
# api_id / api_hash берутся на https://my.telegram.org → API development tools.
# Номер — ОТДЕЛЬНЫЙ, не основной: при блокировке теряется только он.
TG_API_ID=
TG_API_HASH=
TG_PHONE=
# StringSession после первой авторизации. Хранить строкой, а не файлом:
# на эфемерной ФС файловая сессия умирает при первом же перезапуске.
TG_SESSION=

# ── База ────────────────────────────────────────────────────────────────────
# Пароль читает и docker-compose.yml (для контейнера postgres), и DATABASE_URL
# ниже — они обязаны совпадать. Пусто = compose подставит заглушку `sniffer`;
# на сервере, где живут ещё три проекта, так оставлять нельзя.
POSTGRES_PASSWORD=
# На сервере хост — имя сервиса и порт 5432: внутри compose-сети база видна по
# `postgres`, а 5434 — это только проброс на localhost хоста для psql руками.
DATABASE_URL=postgresql+asyncpg://sniffer:sniffer@localhost:5434/sniffer

# ── AIbroker ────────────────────────────────────────────────────────────────
# Отдельный project-key со СВОИМ дневным cap, чтобы бот не мог выесть
# чужую квоту. Заводится через POST /admin/projects с X-Admin-Key.
BROKER_URL=https://aib.zapleo.com
BROKER_PROJECT_KEY=
BROKER_TIMEOUT_S=120

# ── Cloudflare R2 (фото объявлений) ─────────────────────────────────────────
# Пусто = медиа не сохраняем, работает только текст.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sniffer-media

# ── Поведение ───────────────────────────────────────────────────────────────
# Не больше 10 чатов на один живой поиск — иначе FloodWait от Telegram.
LIVE_SEARCH_MAX_CHATS=10
LIVE_SEARCH_CACHE_TTL_S=300
RAW_RETENTION_DAYS=30
PREFILTER_BATCH=20
EXTRACT_BATCH=10
DEFAULT_CITY=nha_trang
LOG_LEVEL=INFO

# ── Веб-интерфейс владельца ─────────────────────────────────────────────────
# Устройство и модель угроз — docs/dashboard.md.
#
# Кто владелец. Одно значение на две задачи: кого пускать в интерфейс и куда
# бот пишет о том, что требует вмешательства. Только числовой id: по username
# бот писать не умеет, и первым он может написать лишь тому, кто нажал
# у него «Старт». Пусто = вход закрыт всем.
OWNER_CHAT_ID=169510539
# Имя бота для Telegram Login Widget. Должно принадлежать тому же боту, что
# BOT_TOKEN: виджет подписывает данные ключом sha256(BOT_TOKEN).
BOT_USERNAME=RecVNbot
# Подписывает НАШУ cookie и токены CSRF. openssl rand -hex 32
# Отдельный секрет от BOT_TOKEN намеренно: один ключ на две цели означает, что
# утечка одной обесценивает обе. Пусто = вход выключен целиком.
DASHBOARD_SESSION_SECRET=
# Шифрует строку сессии юзербота в БД (Fernet). openssl rand -hex 32
# Третий ключ, не переиспользуем предыдущие: у шифрования данных в покое другой
# срок жизни и другой радиус ущерба, чем у подписи cookie. Короче 32 символов
# не принимается — слабый ключ работает так же, как сильный, и молча.
SECRET_ENCRYPTION_KEY=
# Порт слушаем внутри контейнера; наружу публикуется только на 127.0.0.1.
DASHBOARD_PORT=8005

# ── Потолки памяти контейнеров ──────────────────────────────────────────────
# Читаются docker-compose.yml, в приложение не попадают. Пусто = дефолты из
# compose. Сервер общий с Верой и Степаном и уже свопит, поэтому потолки есть
# всегда; подробности и порядок урезания — docs/deploy.md, раздел 9.
SNIFFER_MEM_POSTGRES=384m
SNIFFER_MEM_COLLECTOR=320m
SNIFFER_MEM_WORKER=384m
SNIFFER_MEM_BOT=256m
SNIFFER_MEM_NOTIFIER=192m
SNIFFER_MEM_DASHBOARD=256m
